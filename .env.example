# Copy to .env (gitignored) with `cp .env.example .env`. Task loads it for every task
# (dotenv in Taskfile.yml); variables already set in your shell, and task variables on the
# command line (task dev CONTEXTS=...), take precedence. See docs/development.md.

# ---------------------------------------------------------------------------------------
# Local development (task dev)
# ---------------------------------------------------------------------------------------

# 1 = the agent runs in local mode: your kubeconfig identity, no in-cluster install (dev builds only).
EDDY_AGENT_LOCAL=1
# Kubeconfig contexts to serve, comma-separated, optionally renamed ctx=name. Empty = current context.
EDDY_AGENT_CONTEXTS=
# 1 = allow reconcile/suspend/resume as your kubeconfig identity. Contexts matching PROTECT stay read-only.
EDDY_AGENT_ALLOW_WRITES=0
# Regex of contexts or cluster names that are protected (typed confirmation, always read-only).
EDDY_AGENT_PROTECT=(?i)prod
# Log level of the hub and the agent: debug, info, warn or error.
EDDY_LOG_LEVEL=info

# Ask AI in local dev (optional). Empty = Ask AI off; otherwise anthropic or bedrock.
EDDY_AI_PROVIDER=

# 1 = Ask AI may read pod logs (redacted before they reach the model). Off by default.
EDDY_AI_ALLOW_LOGS=0

# ... with EDDY_AI_PROVIDER=anthropic: your Anthropic API key, and optionally the model.
ANTHROPIC_API_KEY=
EDDY_AI_MODEL=

# ... with EDDY_AI_PROVIDER=bedrock: region and model (inference profile id or ARN, e.g.
# eu.anthropic.claude-haiku-4-5-20251001-v1:0), optionally a guardrail id and version.
EDDY_BEDROCK_REGION=eu-west-2
EDDY_BEDROCK_MODEL_ID=
EDDY_BEDROCK_GUARDRAIL_ID=
EDDY_BEDROCK_GUARDRAIL_VERSION=
# Bedrock credentials come from the AWS default chain: use a profile (SSO works). Left
# commented so an empty value does not override the profile your kubeconfig relies on.
# Never put AWS access keys in this file.
# AWS_PROFILE=my-sso-profile

# ---------------------------------------------------------------------------------------
# Production (reference only: set these via Helm values and Secrets, not a .env file)
# ---------------------------------------------------------------------------------------

# Ask AI is enabled with the hub chart's `config.ai` (provider anthropic or bedrock).
# ANTHROPIC_API_KEY is only for provider anthropic and comes from the chart's
# credentialsSecret. Bedrock uses IRSA or EKS Pod Identity: no keys at all.
# ANTHROPIC_API_KEY=sk-ant-...

# Proxy authentication secret (for reverse proxy auth like oauth2-proxy)
# Generate with: openssl rand -base64 48
# EDDY_PROXY_SECRET=

# Agent configuration (set by the eddy-agent chart in each workload cluster)
# EDDY_CLUSTER=cluster-name
# EDDY_HUB_URL=wss://hub.example.com/agent/v1/connect
# EDDY_AGENT_TOKEN=token-value
# EDDY_HUB_CA_FILE=/path/to/ca.crt
# EDDY_WATCH_NAMESPACES=default,kube-system
# EDDY_ALLOWED_GROUP_PREFIXES=eddy:
# EDDY_DENY_USER_PREFIXES=system:,eks:,kubernetes-admin
# EDDY_ALLOW_INSECURE=0
# EDDY_HEALTH_ADDR=:8081
