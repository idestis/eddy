# Eddy Hub configuration
# See docs/install.md for detailed setup instructions

# Anthropic API key (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...

# Proxy authentication secret (for reverse proxy auth like oauth2-proxy)
# Generate with: openssl rand -base64 48
EDDY_PROXY_SECRET=

# AWS configuration (if using Bedrock instead of Anthropic API)
AWS_REGION=us-east-1

# Agent configuration (for each agent workload cluster)
EDDY_CLUSTER=cluster-name
EDDY_HUB_URL=wss://hub.example.com/agent/v1/connect
EDDY_AGENT_TOKEN=token-value
EDDY_HUB_CA_FILE=/path/to/ca.crt
EDDY_WATCH_NAMESPACES=default,kube-system
EDDY_ALLOWED_GROUP_PREFIXES=eddy:
EDDY_DENY_USER_PREFIXES=system:,eks:,kubernetes-admin
EDDY_ALLOW_INSECURE=0
EDDY_HEALTH_ADDR=:8081
